.product-card { border-radius: 8px; overflow: hidden; margin-bottom: 10px; }
.image { width: 100%; height: 140px; display: block; background: #f9f9f9; }
.image-placeholder { width: 100%; height: 140px; display: flex; align-items: center; justify-content: center; background: #f9f9f9; font-size: 40px; }
.info { padding: 8px; }
.name { font-size: 13px; color: #333; display: block; margin-bottom: 6px; }
.bottom { display: flex; align-items: center; justify-content: space-between; }
.btn-add { width: 24px; height: 24px; border-radius: 12px; background: #07c160; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 600; }
.btn-add.disabled { background: #ccc; }
.stock { font-size: 10px; display: block; }
.stock.soldout { color: #ee0a24; }
.stock.low { color: #ff976a; }
