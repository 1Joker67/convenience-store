<!-- pages/admin/login/login.wxml — 管理端登录 -->
<view class="page">
  <view class="login-card">
    <view class="login-header">
      <text class="login-icon">🔐</text>
      <text class="login-title">店主管理后台</text>
      <text class="login-desc">仅限管理员登录</text>
    </view>

    <view class="input-box">
      <input
        class="pwd-input"
        type="password"
        placeholder="请输入管理密码"
        value="{{password}}"
        bindinput="onInput"
        bindconfirm="onLogin"
        placeholder-class="placeholder"
        maxlength="20"
      />
    </view>

    <view wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</view>

    <view
      class="btn {{loading ? 'btn-disabled' : 'btn-primary'}}"
      bindtap="onLogin"
    >
      {{loading ? '验证中...' : '进入后台'}}
    </view>
  </view>
</view>
