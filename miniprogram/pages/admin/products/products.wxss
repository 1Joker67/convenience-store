/* pages/admin/products/products.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 15px;
  background-color: #ffffff;
  border-bottom: 1px solid #f0f0f0;
}

.title {
  font-size: 14px;
  color: #333333;
}

.product-list {
  padding: 10px 15px;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 10px 12px;
}

.item-image {
  width: 50px;
  height: 50px;
  border-radius: 4px;
  flex-shrink: 0;
}

.item-image-placeholder {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 4px;
  font-size: 24px;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 10px;
}

.item-name {
  font-size: 14px;
  color: #333333;
  display: block;
}

.actions {
  display: flex;
  align-items: center;
  margin-left: 10px;
}

.action-btn {
  font-size: 12px;
  color: #07c160;
  padding: 4px 8px;
}

.action-btn.danger {
  color: #ee0a24;
  margin-left: 5px;
}

/* 表单 */
.form-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 15px;
  background-color: #ffffff;
  font-size: 15px;
}

.form-title {
  font-weight: 600;
  color: #333333;
}

.form-body {
  padding: 15px;
}

.form-item {
  background-color: #ffffff;
  padding: 12px 15px;
  border-radius: 8px;
  margin-bottom: 10px;
}

.form-item .label {
  font-size: 13px;
  color: #999999;
  display: block;
  margin-bottom: 8px;
}

.form-item .input {
  font-size: 15px;
  color: #333333;
  width: 100%;
}

.image-upload {
  width: 100px;
  height: 100px;
  border-radius: 8px;
  overflow: hidden;
}

.upload-placeholder {
  width: 100px;
  height: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border: 1px dashed #e8e8e8;
  border-radius: 8px;
  font-size: 24px;
}

.preview-image {
  width: 100px;
  height: 100px;
  border-radius: 8px;
}

.picker-value {
  font-size: 15px;
  color: #333333;
  padding: 8px 0;
}

.radio-item {
  margin-right: 20px;
  font-size: 14px;
  color: #333333;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
}
