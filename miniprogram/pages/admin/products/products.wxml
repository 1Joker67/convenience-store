<!-- pages/admin/products/products.wxml — 商品管理 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="onNavTap" data-page="orders"><text>📋 订单</text></view>
    <view class="nav-item active"><text>📦 商品</text></view>
    <view class="nav-item" bindtap="onNavTap" data-page="categories"><text>📂 分类</text></view>
    <view class="nav-item" bindtap="onNavTap" data-page="settings"><text>⚙️ 设置</text></view>
    <text class="logout-btn" bindtap="onLogout">退出</text>
  </view>
  <!-- 商品列表 -->
  <view wx:if="{{!showForm}}">
    <view class="header-bar">
      <view class="flex-1">
        <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onSwitchCategory">
          <view class="category-switch">
            <text class="title" wx:if="{{!filterCategoryId}}">全部商品（{{products.length}}）</text>
            <text class="title" wx:else>「{{filterCategoryName}}」（{{products.length}}）</text>
            <text class="switch-icon">▾</text>
          </view>
        </picker>
      </view>
      <view class="btn btn-small btn-primary" bindtap="onAdd">添加商品</view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>

    <view wx:elif="{{products.length === 0}}" class="empty-state">
      <text class="icon">📦</text>
      <text class="text">暂无商品，请添加</text>
    </view>

    <view wx:else class="product-list">
      <view
        wx:for="{{products}}"
        wx:key="_id"
        class="card product-item"
      >
        <image
          wx:if="{{item.image}}"
          src="{{item.image}}"
          class="item-image"
          mode="aspectFill"
        />
        <view wx:else class="item-image-placeholder">📦</view>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="price">¥{{item.price}}</text>
          <text class="text-sm text-secondary">库存: {{item.stock !== undefined ? item.stock : '不限'}}</text>
        </view>
        <text class="tag {{item.status === 'on' ? 'tag-green' : 'tag-gray'}}">
          {{item.status === 'on' ? '上架' : '下架'}}
        </text>
        <view class="actions">
          <text class="action-btn" data-product="{{item}}" bindtap="onEdit">编辑</text>
          <text class="action-btn danger" data-product="{{item}}" bindtap="onDelete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加/编辑表单 -->
  <view wx:if="{{showForm}}" class="form-page">
    <view class="form-header">
      <text bindtap="onCancel">取消</text>
      <text class="form-title">{{editMode ? '编辑商品' : '添加商品'}}</text>
      <text class="text-primary" bindtap="onSubmit">保存</text>
    </view>

    <view class="form-body">
      <view class="form-item">
        <text class="label">商品图片</text>
        <view class="image-upload" bindtap="onUploadImage">
          <image wx:if="{{form.image}}" src="{{form.image}}" class="preview-image" mode="aspectFill" />
          <view wx:else class="upload-placeholder">
            <text>📷</text>
            <text class="text-sm text-secondary">点击上传</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="label">商品名称</text>
        <input class="input" placeholder="请输入名称" value="{{form.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-item">
        <text class="label">价格（元）</text>
        <input class="input" type="digit" placeholder="请输入价格" value="{{form.price}}" bindinput="onPriceInput" />
      </view>

      <view class="form-item">
        <text class="label">库存数量</text>
        <input class="input" type="number" placeholder="留空则不限制" value="{{form.stock}}" bindinput="onStockInput" />
      </view>

      <view class="form-item">
        <text class="label">所属分类</text>
        <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
          <view class="picker-value">
            {{selectedCategoryName || '请选择分类'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">状态</text>
        <radio-group bindchange="onStatusChange">
          <label class="radio-item">
            <radio value="on" checked="{{form.status === 'on'}}" color="#07c160" />上架
          </label>
          <label class="radio-item">
            <radio value="off" checked="{{form.status === 'off'}}" color="#07c160" />下架
          </label>
        </radio-group>
      </view>
    </view>
  </view>
</view>
