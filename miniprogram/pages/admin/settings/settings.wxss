.page { min-height: 100vh; background-color: #f5f5f5; }
.section { margin-top: 10px; }
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 15px; font-size: 15px; font-weight: 600; color: #333;
}
.announce-input {
  width: 100%; min-height: 80px; font-size: 14px;
  color: #333; border: none; outline: none; resize: none;
  box-sizing: border-box;
}
.time-picker {
  flex: 1; height: 40px; line-height: 40px; text-align: center;
  font-size: 18px; font-weight: 600; color: #07c160;
  border: 1px solid #e8e8e8; border-radius: 6px;
  background-color: #f9f9f9;
}
.loading { text-align: center; padding: 40px; color: #999; }
