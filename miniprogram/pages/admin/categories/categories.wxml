<!-- pages/admin/categories/categories.wxml — 分类管理 -->
<view class="page">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="onNavTap" data-page="orders"><text>📋 订单</text></view>
    <view class="nav-item" bindtap="onNavTap" data-page="products"><text>📦 商品</text></view>
    <view class="nav-item active"><text>📂 分类</text></view>
    <text class="logout-btn" bindtap="onLogout">退出</text>
  </view>

  <view wx:if="{{!showForm}}">
    <view class="header-bar">
      <text class="title">分类列表</text>
      <view class="btn btn-small btn-primary" bindtap="onAdd">添加分类</view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>

    <view wx:elif="{{categories.length === 0}}" class="empty-state">
      <text class="icon">📂</text>
      <text class="text">暂无分类</text>
    </view>

    <view wx:else class="category-list">
      <view wx:for="{{categories}}" wx:key="_id" class="card category-item">
        <view class="sort-btns">
          <view class="sort-btn {{index === 0 ? 'disabled' : ''}}" data-id="{{item._id}}" catchtap="onMoveUp">▲</view>
          <view class="sort-btn {{index === categories.length - 1 ? 'disabled' : ''}}" data-id="{{item._id}}" catchtap="onMoveDown">▼</view>
        </view>
        <text class="cat-name flex-1">{{item.name}}</text>
        <text class="cat-count text-sm text-secondary" bindtap="onGoProducts" data-id="{{item._id}}" data-name="{{item.name}}">商品</text>
        <view class="actions">
          <text class="action-btn" data-category="{{item}}" catchtap="onEdit">编辑</text>
          <text class="action-btn danger" data-category="{{item}}" catchtap="onDelete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加/编辑弹窗 -->
  <view wx:if="{{showForm}}" class="form-page">
    <view class="form-header">
      <text bindtap="onCancel">取消</text>
      <text class="form-title">{{editMode ? '编辑分类' : '添加分类'}}</text>
      <text class="text-primary" bindtap="onSubmit">保存</text>
    </view>
    <view class="form-body">
      <view class="form-item">
        <text class="label">分类名称</text>
        <input class="input" placeholder="请输入分类名称" value="{{formName}}" bindinput="onInput" focus />
      </view>
    </view>
  </view>
</view>
