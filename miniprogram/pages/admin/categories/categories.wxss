/* pages/admin/categories/categories.wxss */
.page { min-height: 100vh; background-color: #f5f5f5; }

.header-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 15px; background-color: #ffffff; border-bottom: 1px solid #f0f0f0;
}
.title { font-size: 14px; color: #333333; }

.category-list { padding: 10px 15px; }

.category-item {
  display: flex; align-items: center;
  padding: 12px 12px;
}

/* 排序按钮 */
.sort-btns {
  display: flex; flex-direction: column;
  margin-right: 10px;
}
.sort-btn {
  width: 22px; height: 18px;
  display: flex; align-items: center; justify-content: center;
  font-size: 8px; color: #07c160;
  background-color: #f0fdf4; border-radius: 2px;
  line-height: 1;
}
.sort-btn + .sort-btn { margin-top: 2px; }
.sort-btn.disabled { color: #ccc; background-color: #f5f5f5; pointer-events: none; }

.cat-name { font-size: 15px; color: #333333; }
.cat-count {
  color: #07c160; margin-left: 10px;
  padding: 2px 8px; border: 1px solid #07c160; border-radius: 10px;
}

.actions { display: flex; align-items: center; margin-left: 8px; }
.action-btn { font-size: 12px; color: #07c160; padding: 4px 6px; }
.action-btn.danger { color: #ee0a24; }

/* 表单 */
.form-page { min-height: 100vh; background-color: #f5f5f5; }
.form-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 15px; background-color: #ffffff; font-size: 15px;
}
.form-title { font-weight: 600; color: #333333; }
.form-body { padding: 15px; }
.form-item { background-color: #ffffff; padding: 15px; border-radius: 8px; }
.form-item .label { font-size: 13px; color: #999999; display: block; margin-bottom: 8px; }
.form-item .input { font-size: 16px; color: #333333; width: 100%; }
.loading { text-align: center; padding: 40px; color: #999999; }
