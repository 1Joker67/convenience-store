/* pages/admin/orders/orders.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header-bar {
  display: flex;
  align-items: center;
  padding: 10px 15px;
  background-color: #ffffff;
  border-bottom: 1px solid #f0f0f0;
}

.filter-tag {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 12px;
  background-color: #f5f5f5;
  color: #666666;
  margin-right: 8px;
  display: inline-block;
}

.filter-tag.active {
  background-color: #e8f8ef;
  color: #07c160;
}

.logout-btn {
  font-size: 13px;
  color: #ee0a24;
  padding: 5px;
}

.order-list {
  padding: 10px 15px;
}

.order-card {
  padding: 12px 15px;
}

.avatar {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  margin-right: 6px;
  vertical-align: middle;
}

.goods-row {
  display: flex;
  align-items: center;
  padding: 3px 0;
}

.contact-info {
  margin-top: 6px;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
}
