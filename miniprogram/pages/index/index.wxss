/* pages/index/index.wxss — 首页样式 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 10px 15px;
  background-color: #ffffff;
}

.search-input {
  display: flex;
  align-items: center;
  height: 36px;
  border-radius: 18px;
  background-color: #f5f5f5;
  padding: 0 15px;
}

.search-icon {
  font-size: 14px;
  margin-right: 6px;
}

.search-placeholder {
  font-size: 13px;
  color: #999999;
}

/* 主体 */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类 */
.category-list {
  width: 90px;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50px;
  font-size: 13px;
  color: #666666;
  position: relative;
}

.category-item.active {
  background-color: #ffffff;
  color: #333333;
  font-weight: 600;
}

.active-bar {
  position: absolute;
  left: 0;
  top: 12px;
  bottom: 12px;
  width: 3px;
  background-color: #07c160;
  border-radius: 0 2px 2px 0;
}

/* 右侧商品 */
.product-list {
  flex: 1;
  background-color: #ffffff;
  padding: 10px;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
}

.product-card {
  width: calc(50% - 5px);
  margin-right: 10px;
  margin-bottom: 10px;
  background-color: #ffffff;
  border-radius: 8px;
  overflow: hidden;
}

.product-card:nth-child(2n) {
  margin-right: 0;
}

.product-image {
  width: 100%;
  height: 150px;
  display: block;
}

.product-image-placeholder {
  width: 100%;
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  font-size: 40px;
}

.product-info {
  padding: 8px;
}

.product-name {
  font-size: 13px;
  color: #333333;
  display: block;
  margin-bottom: 6px;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn-add {
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
  font-size: 13px;
}
