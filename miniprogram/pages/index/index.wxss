/* pages/index/index.wxss — 首页（含购物车） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 10px 15px;
  background-color: #ffffff;
}
.search-input {
  display: flex;
  align-items: center;
  height: 36px;
  border-radius: 18px;
  background-color: #f5f5f5;
  padding: 0 15px;
}
.search-icon { font-size: 14px; margin-right: 6px; }
.search-placeholder { font-size: 13px; color: #999999; }

/* 主体 */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
  padding-bottom: 50px; /* 底部购物车栏高度 */
}

/* 左侧分类 */
.category-list {
  width: 90px;
  background-color: #f5f5f5;
  flex-shrink: 0;
}
.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50px;
  font-size: 13px;
  color: #666666;
  position: relative;
}
.category-item.active {
  background-color: #ffffff;
  color: #333333;
  font-weight: 600;
}
.active-bar {
  position: absolute;
  left: 0; top: 12px; bottom: 12px;
  width: 3px;
  background-color: #07c160;
  border-radius: 0 2px 2px 0;
}

/* 右侧商品 */
.product-list {
  flex: 1;
  background-color: #ffffff;
  padding: 10px;
}
.product-grid {
  display: flex;
  flex-wrap: wrap;
}
.product-card {
  width: calc(50% - 5px);
  margin-right: 10px;
  margin-bottom: 10px;
  border-radius: 8px;
  overflow: hidden;
}
.product-card:nth-child(2n) { margin-right: 0; }
.product-image {
  width: 100%;
  height: 140px;
  display: block;
  background-color: #f9f9f9;
}
.product-image-placeholder {
  width: 100%;
  height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
  font-size: 40px;
}
.product-info { padding: 8px; }
.product-name {
  font-size: 13px;
  color: #333333;
  display: block;
  margin-bottom: 6px;
}
.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.btn-add {
  width: 24px; height: 24px;
  border-radius: 12px;
  background-color: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 600;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
  font-size: 13px;
}

/* ========== 底部购物车栏 ========== */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  height: 50px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 15px;
  box-shadow: 0 -2px 6px rgba(0,0,0,0.04);
  z-index: 50;
}
.cart-icon-wrap {
  position: relative;
  margin-right: 10px;
}
.cart-icon { font-size: 24px; }
.cart-badge {
  position: absolute;
  top: -6px; right: -8px;
  min-width: 16px; height: 16px;
  background-color: #ee0a24;
  color: #fff;
  font-size: 10px;
  border-radius: 8px;
  text-align: center;
  line-height: 16px;
  padding: 0 4px;
}
.cart-total {
  flex: 1;
  font-size: 15px;
  font-weight: 600;
  color: #ee0a24;
}
.cart-total.placeholder { color: #999999; font-weight: 400; font-size: 13px; }
.cart-checkout-btn {
  padding: 8px 20px;
  background-color: #07c160;
  color: #ffffff;
  border-radius: 20px;
  font-size: 14px;
}
.cart-checkout-btn.disabled {
  background-color: #ccc;
}

/* ========== 购物车弹出层 ========== */
.cart-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0,0,0,0.4);
  z-index: 80;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s;
}
.cart-overlay.show { opacity: 1; visibility: visible; }

.cart-popup {
  position: fixed;
  bottom: 0;
  left: 0; right: 0;
  max-height: 50vh;
  background-color: #ffffff;
  border-radius: 16px 16px 0 0;
  z-index: 90;
  transform: translateY(100%);
  transition: transform 0.25s;
  display: flex;
  flex-direction: column;
}
.cart-popup.show { transform: translateY(0); }

.cart-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}
.cart-popup-title { font-size: 16px; font-weight: 600; }
.cart-clear { font-size: 13px; color: #999999; }

.cart-popup-list {
  flex: 1;
  padding: 10px 15px;
  max-height: 30vh;
}
.cart-popup-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}
.cart-popup-item:last-child { border-bottom: none; }
.cart-popup-item .item-name {
  font-size: 14px;
  color: #333333;
  display: block;
  margin-bottom: 2px;
}
.item-quantity {
  display: flex;
  align-items: center;
}
.qty-btn {
  width: 28px; height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e8e8e8;
  font-size: 16px;
  color: #333;
  border-radius: 4px 0 0 4px;
}
.qty-btn.plus {
  border-radius: 0 4px 4px 0;
  background-color: #07c160;
  color: #fff;
  border-color: #07c160;
}
.qty-num {
  width: 32px; height: 28px;
  text-align: center;
  font-size: 14px;
  line-height: 28px;
  border-top: 1px solid #e8e8e8;
  border-bottom: 1px solid #e8e8e8;
}
.cart-empty-hint {
  text-align: center;
  padding: 30px;
  color: #999;
  font-size: 14px;
}
