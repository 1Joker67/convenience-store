<!-- pages/address/address.wxml — 地址管理 -->
<view class="page">
  <view wx:if="{{!showForm}}">
    <view class="header-bar">
      <text class="title">收货地址（{{list.length}}）</text>
      <view class="btn btn-small btn-primary" bindtap="onAdd">新增地址</view>
    </view>

    <view wx:if="{{list.length === 0}}" class="empty-state">
      <text class="icon">📍</text>
      <text class="text">暂无地址，请新增</text>
    </view>

    <view wx:else class="addr-list">
      <view wx:for="{{list}}" wx:key="id" class="card addr-item" data-addr="{{item}}" bindtap="onSelect">
        <view class="addr-top">
          <text class="addr-name">{{item.name || '未填姓名'}}</text>
          <text class="addr-phone">{{item.phone}}</text>
        </view>
        <text class="addr-text">{{item.address}}</text>
        <view class="addr-actions">
          <text class="act-btn" data-addr="{{item}}" catchtap="onEdit">编辑</text>
          <text class="act-btn danger" data-id="{{item.id}}" catchtap="onDelete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 表单 -->
  <view wx:if="{{showForm}}" class="form-page">
    <view class="form-header">
      <text bindtap="onCancel">取消</text>
      <text class="form-title">{{editId ? '编辑地址' : '新增地址'}}</text>
      <text class="text-primary" bindtap="onSave">保存</text>
    </view>
    <view class="form-body">
      <view class="input-group">
        <view class="input-row">
          <text class="label">收货人</text>
          <input placeholder="姓名（选填）" value="{{form.name}}" bindinput="onNameInput" placeholder-class="placeholder" />
        </view>
        <view class="input-row">
          <text class="label">手机号</text>
          <input type="number" maxlength="11" placeholder="手机号" value="{{form.phone}}" bindinput="onPhoneInput" placeholder-class="placeholder" />
        </view>
        <view class="input-row">
          <text class="label">地址</text>
          <input placeholder="详细地址" value="{{form.address}}" bindinput="onAddrInput" placeholder-class="placeholder" />
        </view>
      </view>
    </view>
  </view>
</view>
