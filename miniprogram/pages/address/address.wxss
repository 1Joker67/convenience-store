.page { min-height: 100vh; background: #f5f5f5; }
.header-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 15px; background: #fff; border-bottom: 1px solid #f0f0f0;
}
.title { font-size: 14px; color: #333; }

.addr-list { padding: 10px 15px; }
.addr-item { padding: 14px 15px; position: relative; }
.addr-top { display: flex; align-items: center; margin-bottom: 6px; }
.addr-name { font-size: 15px; font-weight: 600; color: #333; margin-right: 12px; }
.addr-phone { font-size: 14px; color: #666; }
.addr-text { font-size: 13px; color: #888; display: block; }
.addr-actions { margin-top: 10px; display: flex; }
.act-btn { font-size: 12px; color: #07c160; padding: 4px 10px; border: 1px solid #07c160; border-radius: 4px; margin-right: 8px; }
.act-btn.danger { color: #ee0a24; border-color: #ee0a24; }

/* 表单 */
.form-page { min-height: 100vh; background: #f5f5f5; }
.form-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 15px; background: #fff; font-size: 15px;
}
.form-title { font-weight: 600; color: #333; }
.form-body { padding: 15px; }
