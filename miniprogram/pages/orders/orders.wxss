/* pages/orders/orders.wxss — 订单样式 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.filter-bar {
  display: flex;
  background-color: #ffffff;
  padding: 10px 15px;
  border-bottom: 1px solid #f0f0f0;
}

.filter-item {
  font-size: 13px;
  color: #666666;
  padding: 5px 14px;
  border-radius: 15px;
  margin-right: 10px;
  background-color: #f5f5f5;
}

.filter-item.active {
  background-color: #e8f8ef;
  color: #07c160;
}

.order-list {
  padding: 10px 15px;
}

.order-card {
  padding: 12px 15px;
}

.order-goods {
  display: flex;
  align-items: center;
  padding: 4px 0;
}

.goods-name {
  flex: 1;
  font-size: 13px;
  color: #333333;
  margin-right: 10px;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
}
