/* pages/checkout/checkout.wxss — 下单结算样式 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 80px;
}

.section {
  margin-top: 10px;
  background-color: #ffffff;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #333333;
  padding: 12px 15px 8px;
}

.cart-list {
  padding: 0 15px;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-image {
  width: 50px;
  height: 50px;
  border-radius: 4px;
  flex-shrink: 0;
}

.item-image-placeholder {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 4px;
  font-size: 24px;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 10px;
}

.item-name {
  font-size: 13px;
  color: #333333;
  display: block;
  margin-bottom: 4px;
}

.total-label {
  font-size: 15px;
  color: #333333;
}
