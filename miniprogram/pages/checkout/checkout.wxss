/* pages/checkout/checkout.wxss */
.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 80px; }
.section { margin-top: 10px; background: #fff; }

/* 地址选择 */
.addr-selected { padding: 16px 15px; }
.addr-top-line { display: flex; align-items: center; }
.addr-name { font-size: 16px; font-weight: 600; color: #333; margin-right: 12px; }
.addr-phone { font-size: 14px; color: #666; flex: 1; }
.addr-arrow { font-size: 14px; color: #ccc; }
.addr-text { font-size: 13px; color: #888; margin-top: 6px; display: block; }

.addr-empty {
  display: flex; align-items: center; padding: 20px 15px;
  font-size: 14px; color: #999;
}
.addr-icon { font-size: 20px; margin-right: 8px; }

/* 备注 */
.section-title { font-size: 14px; font-weight: 600; color: #333; padding: 12px 15px 8px; }

/* 商品清单 */
.cart-list { padding: 0 15px; }
.cart-item { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
.cart-item:last-child { border-bottom: none; }
.item-image { width: 50px; height: 50px; border-radius: 4px; flex-shrink: 0; }
.item-image-placeholder { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: #f5f5f5; border-radius: 4px; font-size: 24px; flex-shrink: 0; }
.item-info { flex: 1; margin-left: 10px; }
.item-name { font-size: 13px; color: #333; display: block; margin-bottom: 4px; }
.total-label { font-size: 15px; color: #333; }
