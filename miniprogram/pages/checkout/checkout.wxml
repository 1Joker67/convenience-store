<!-- pages/checkout/checkout.wxml — 下单结算 -->
<view class="page">
  <!-- 收货信息 -->
  <view class="section">
    <view class="section-title">收货信息</view>
    <view class="input-group">
      <view class="input-row">
        <text class="label">收货地址</text>
        <input
          placeholder="请输入详细地址"
          value="{{address}}"
          bindinput="onAddressInput"
          placeholder-class="placeholder"
        />
      </view>
      <view class="input-row">
        <text class="label">联系电话</text>
        <input
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
          placeholder-class="placeholder"
        />
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <view class="input-group">
      <view class="input-row">
        <textarea
          placeholder="如有特殊需求请备注"
          value="{{remark}}"
          bindinput="onRemarkInput"
          placeholder-class="placeholder"
          maxlength="200"
        />
      </view>
    </view>
  </view>

  <!-- 商品清单 -->
  <view class="section">
    <view class="section-title">商品清单</view>
    <view class="cart-list">
      <view
        wx:for="{{cartList}}"
        wx:key="_id"
        class="cart-item"
      >
        <image
          wx:if="{{item.image}}"
          src="{{item.image}}"
          class="item-image"
          mode="aspectFill"
        />
        <view wx:else class="item-image-placeholder">📦</view>
        <view class="item-info">
          <text class="item-name text-ellipsis">{{item.name}}</text>
          <view class="flex-between">
            <text class="price">{{item.price}}</text>
            <text class="text-secondary text-sm">×{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算 -->
  <view class="bottom-bar">
    <view class="flex-1">
      <text class="total-label">合计：</text>
      <text class="price text-xl">{{totalAmount}}</text>
    </view>
    <view
      class="btn {{submitting ? 'btn-disabled' : 'btn-primary'}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中...' : '提交订单并支付'}}
    </view>
  </view>
</view>
