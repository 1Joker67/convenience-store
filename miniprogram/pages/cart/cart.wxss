/* pages/cart/cart.wxss — 购物车样式 */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 80px;
}

.cart-list {
  padding: 10px 0;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  margin-bottom: 1px;
  padding: 12px 15px;
}

.item-image {
  width: 70px;
  height: 70px;
  border-radius: 6px;
  flex-shrink: 0;
}

.item-image-placeholder {
  width: 70px;
  height: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  border-radius: 6px;
  font-size: 30px;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  margin-left: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 70px;
}

.item-name {
  font-size: 14px;
  color: #333333;
}

.item-quantity {
  display: flex;
  align-items: center;
  margin-left: 10px;
}

.qty-btn {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e8e8e8;
  font-size: 16px;
  color: #333333;
}

.qty-btn:first-child {
  border-radius: 4px 0 0 4px;
}

.qty-btn:last-child {
  border-radius: 0 4px 4px 0;
  background-color: #07c160;
  color: #ffffff;
  border-color: #07c160;
}

.qty-num {
  width: 32px;
  text-align: center;
  font-size: 14px;
  border-top: 1px solid #e8e8e8;
  border-bottom: 1px solid #e8e8e8;
  height: 28px;
  line-height: 28px;
}

.item-remove {
  margin-left: 10px;
  font-size: 16px;
  padding: 5px;
}

.total-label {
  font-size: 14px;
  color: #333333;
}
